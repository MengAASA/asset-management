generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
  assets    Asset[]

  @@map("department")
}

model Employee {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  jobTitle     String
  phone        String?
  staffId      String?           @unique
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assignments  AssetAssignment[]

  @@map("employee")
}

model AssetCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  type   String
  icon   String?
  assets Asset[]

  @@map("assetcategory")
}

model Asset {
  id              String              @id @default(cuid())
  assetTag        String              @unique
  name            String
  brand           String?
  model           String?
  serialNumber    String?             @unique
  status          String              @default("In Stock")
  assetStatus     String?
  officeLicense   String?
  categoryId      String
  category        AssetCategory       @relation(fields: [categoryId], references: [id])
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])
  location        String?
  purchaseDate    DateTime?
  purchaseCost    Float?
  vendor          String?
  warrantyExpiry  DateTime?
  ipAddress       String?
  macAddress      String?
  operatingSystem String?
  processor       String?
  ram             String?
  storage         String?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  assignments     AssetAssignment[]
  maintenance     MaintenanceRecord[]

  @@map("asset")
}

model AssetAssignment {
  id           String    @id @default(cuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate DateTime  @default(now())
  returnedDate DateTime?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  @@map("assetassignment")
}

model MaintenanceRecord {
  id                  String    @id @default(cuid())
  assetId             String
  asset               Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type                String
  description         String    @db.Text
  cost                Float?
  performedBy         String?
  vendor              String?
  maintenanceDate     DateTime
  nextMaintenanceDate DateTime?
  status              String    @default("Completed")
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())

  @@map("maintenancerecord")
}

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("systemconfig")
}

// On-demand AD sync: the app creates a request, the on-prem agent claims it,
// queries AD and pushes the users back as JSON.
model AdSyncRequest {
  id          String    @id @default(cuid())
  status      String    @default("pending") // pending | processing | completed | failed
  requestedBy String?
  payload     String?   @db.LongText
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  claimedAt   DateTime?
  completedAt DateTime?

  @@index([status, createdAt])
  @@map("adsyncrequest")
}

model User {
  id        String   @id @default(cuid())
  name      String
  staffId   String?  @unique
  email     String   @unique
  password  String
  role      String   @default("user")
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("passwordresettoken")
}

model NotificationLog {
  id         String   @id @default(cuid())
  licenseId  String
  threshold  Int      // 60 or 14 (days before expiry)
  renewalEnd DateTime // ties the log to a specific renewal period
  sentAt     DateTime @default(now())

  @@unique([licenseId, threshold, renewalEnd])
  @@map("notificationlog")
}

model Expense {
  id               String    @id @default(cuid())
  nature           String
  category         String
  subCategory      String?
  amp              String?
  costCtr          String?
  supplier         String
  dateEntry        DateTime?
  phnRefLetter     String?
  agreementPo      String?
  typeOfRenewal    String?
  quotationNo      String?
  invoiceNo        String?
  doNo             String?
  services         String?
  description      String?   @db.Text
  licenseProductId String?
  qty              Float?
  unitPrice        Float?
  unit             String?
  subTotalRm       Float?
  sstRm            Float?
  sstTotalRm       Float?
  grandTotalRm     Float?
  effectiveDate    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("expense")
}

model SoftwareLicense {
  id            String    @id @default(cuid())
  name          String
  vendor        String
  refLetter     String?
  refLetterDate DateTime?
  version       String?
  renewalStart  DateTime?
  renewalEnd    DateTime?
  itSection     String?
  status        String    @default("On Going")
  licenseKey    String?
  licenseType   String
  cost          Float?
  totalSeats    Int       @default(1)
  usedSeats     Int       @default(0)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("softwarelicense")
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  entityLabel String?
  action      String
  userId      String?
  userName    String?
  changes     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("auditlog")
}

model FinAsset {
  id                 String    @id @default(cuid())
  finAssetTag        String    @unique
  assetCategory      String
  itAssetId          String?
  assetType          String?
  assetStatus        String?
  serialNumberLic    String?
  brand              String?
  model              String?
  os                 String?
  qty                Int?
  department         String?
  plant              String?
  approvedFinCapexNo String?
  dateOfPurchase     DateTime?
  purchaseOrder      String?
  totalAmountRm      Float?
  supplier           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("finasset")
}
